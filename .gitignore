# Compiled Go binary (built via `go build ./cmd/api`)
/cmd/api/api
*.exe

# Local env / secrets
.env
.env.*
!.env.example

# Secret material (GitHub App private key, TLS certs, etc.) — the folder
# itself is tracked (via .gitkeep) so it always exists, its contents never are.
secret/*
!secret/.gitkeep

# Editor / OS
.vscode/
.DS_Store

# Node / frontend (lives in a separate repo)
node_modules/
*.tsbuildinfo
