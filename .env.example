# .env.example - Template for environment variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false
ENABLE_METRICS=true

# Database Configuration
# Required: docker-compose.yml and scripts/dev.sh have no default password.
POSTGRES_PASSWORD=your_password_here
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=gravyflow
PGUSER=postgres
PGPASSWORD=your_password_here
DATABASE_URL=postgres://postgres:your_password_here@127.0.0.1:5433/gravyflow?sslmode=disable

# Redis Configuration
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security — REQUIRED. The API refuses to start if either is missing, shorter
# than 32 characters, or a value published in this repo (cmd/api/secrets.go).
#   AUTH_JWT_SECRET:        openssl rand -base64 48
#     Rotating it signs everyone out; nothing else breaks.
#   APP_ENV_ENCRYPTION_KEY: openssl rand -base64 32
#     Encrypts every app's stored env vars. NEVER change it on a running
#     platform — stored values become unreadable. Back it up with the DB.
AUTH_JWT_SECRET=
APP_ENV_ENCRYPTION_KEY=

# Grafana admin password (monitoring profile) — required, no "admin" default.
GRAFANA_PASSWORD=

# Local standby of the primary database (postgres-standby-sync service)
# STANDBY_SYNC_INTERVAL=900      # seconds between copies (data-loss window)
# BACKUP_RETENTION_DAYS=7        # daily primary-YYYYMMDD.dump files kept

# Admin Control Panel
# Comma-separated emails to grant is_admin on startup. Only ever ADDS the
# admin flag to already-registered users — remove an email here plus clear
# is_admin manually in the DB if you need to revoke it. Required to reach
# /api/v1/admin/*: there is no other way to create the first admin account.
ADMIN_BOOTSTRAP_EMAILS=
# Optional token TTL overrides (defaults shown)
# AUTH_MFA_TOKEN_TTL=5m
# AUTH_IMPERSONATION_TOKEN_TTL=15m

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_BURST=200

# Timeouts
SHUTDOWN_GRACE=30s
WRITE_TIMEOUT=15s
READ_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Database Connection Pool
PGCONNECTATTEMPTS=30
PGCONNECTRETRYINTERVAL=1s
PGMAXCONNS=10
PGMINCONNS=2
PGMAXCONNLIFETIME=30m
PGMAXCONNIDLETIME=5m

# Build Configuration
GRAVYFLOW_APPS_DIR=/var/lib/gravyflow/apps
NIXPACKS_CACHE_DIR=/var/cache/nixpacks
GRAVYFLOW_DISABLE_BUILDKIT=0
# GitHub App (repository picker + token-injected clones). Leave GITHUB_APP_ID
# empty to disable. In the app's settings on GitHub:
#   Callback URL / Setup URL: https://<api-host>/api/v1/integrations/github/callback
#   Enable "Request user authorization (OAuth) during installation"
#   Webhook URL: https://<api-host>/api/v1/webhooks/github
#   Repository permissions: Contents (read), Metadata (read)
#   Subscribe to events: Installation target (installation and
#   installation_repositories events are delivered automatically)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# PEM contents (literal \n allowed) or a path to the .pem file
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_WEBHOOK_SECRET=
# Where the setup callback sends the browser back to
GRAVYFLOW_DASHBOARD_URL=http://localhost:3000/dashboard

# ----------------------------------------------------------------------------
# Database target. "local" ignores DATABASE_URL above and connects to the
# docker-compose "postgres" service via PGHOST/PGUSER/... (same-host queries
# are ~1ms; a remote DB like Neon costs an internet round trip per query and
# makes the dashboard feel slow). Empty or "remote" = use DATABASE_URL.
# ----------------------------------------------------------------------------
GRAVYFLOW_DB_TARGET=remote

# ----------------------------------------------------------------------------
# Deployment worker + git clone
# ----------------------------------------------------------------------------
# Deployments processed at once (1 = strictly one clone/build at a time).
ASYNQ_CONCURRENCY=2
# Hard ceiling for one git clone/fetch, and how long git may print nothing
# before it is killed as stalled (0 disables the stall check).
GRAVYFLOW_GIT_CLONE_TIMEOUT=10m
GRAVYFLOW_GIT_STALL_TIMEOUT=2m
# Refuse to clone a GitHub repository whose latest commit is bigger than this
# many MB (0 disables). Checked via the GitHub API before any download.
GRAVYFLOW_MAX_CLONE_SIZE_MB=500

# Abuse detection: how often running apps are sampled for sustained high CPU
# (admin panel risk alerts). 0 disables it.
GRAVYFLOW_RISK_SWEEP_INTERVAL=1m

# ----------------------------------------------------------------------------
# Production (VPS) — public routing through Caddy
# ----------------------------------------------------------------------------
# Host GID of the "docker" group (`getent group docker`); the API needs it to
# use the mounted Docker socket.
# DOCKER_GID=988
# Dashboard + API on one host: /api/* -> API, everything else -> the frontend
# container (gravyflow-frontend:3000 on gravyflow-network). Empty = none.
# GRAVYFLOW_DASHBOARD_HOST=gravyflow.example.com
# Apps are served as <app>.<GRAVYFLOW_APPS_DOMAIN>; needs a wildcard DNS record.
# GRAVYFLOW_APPS_DOMAIN=apps.example.com
# GRAVYFLOW_APPS_URL_SCHEME=https
# Let's Encrypt certificates (ports 80 and 443 must be publicly reachable).
# CADDY_ENABLE_TLS=true
# CADDY_TLS_EMAIL=you@example.com
