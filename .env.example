# .env.example - Template for environment variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=8080
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=false
ENABLE_METRICS=true

# Database Configuration
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=gravyflow
PGUSER=postgres
PGPASSWORD=your_password_here
DATABASE_URL=postgres://postgres:your_password_here@127.0.0.1:5433/gravyflow?sslmode=disable

# Redis Configuration
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Security - GENERATE THESE!
AUTH_JWT_SECRET=generate-a-secure-secret
APP_ENV_ENCRYPTION_KEY=generate-an-encryption-key

# Admin Control Panel
# Comma-separated emails to grant is_admin on startup. Only ever ADDS the
# admin flag to already-registered users — remove an email here plus clear
# is_admin manually in the DB if you need to revoke it. Required to reach
# /api/v1/admin/*: there is no other way to create the first admin account.
ADMIN_BOOTSTRAP_EMAILS=
# Optional token TTL overrides (defaults shown)
# AUTH_MFA_TOKEN_TTL=5m
# AUTH_IMPERSONATION_TOKEN_TTL=15m

# Rate Limiting
RATE_LIMIT=100
RATE_LIMIT_BURST=200

# Timeouts
SHUTDOWN_GRACE=30s
WRITE_TIMEOUT=15s
READ_TIMEOUT=15s
IDLE_TIMEOUT=60s

# Database Connection Pool
PGCONNECTATTEMPTS=30
PGCONNECTRETRYINTERVAL=1s
PGMAXCONNS=10
PGMINCONNS=2
PGMAXCONNLIFETIME=30m
PGMAXCONNIDLETIME=5m

# Build Configuration
GRAVYFLOW_APPS_DIR=/var/lib/gravyflow/apps
NIXPACKS_CACHE_DIR=/var/cache/nixpacks
GRAVYFLOW_DISABLE_BUILDKIT=0